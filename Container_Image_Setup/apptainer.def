Bootstrap: docker
From: ubuntu:22.04

%files
    Spectronaut_{{ SN_VERSION }}.deb /opt/Spectronaut_{{ SN_VERSION }}.deb

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get upgrade -y
    apt-get install -y --no-install-recommends wget ca-certificates libgomp1

    # Add the Microsoft package repo and install the .NET 8 runtime.
    # (Skip/adjust this block if the Spectronaut .deb already pulls in
    # dotnet8 as a dependency via its own repo config.)
    wget -q https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb \
        -O /tmp/packages-microsoft-prod.deb
    dpkg -i /tmp/packages-microsoft-prod.deb
    rm /tmp/packages-microsoft-prod.deb
    apt-get update
    apt-get install -y --no-install-recommends dotnet-runtime-8.0

    # Install Spectronaut
    apt-get update
    apt-get install -y /opt/Spectronaut_{{ SN_VERSION }}.deb
    rm /opt/Spectronaut_{{ SN_VERSION }}.deb

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec spectronaut "$@"

%labels
    Author your-name-here
    Version {{ SN_VERSION }}

%help
    Apptainer/Singularity container for Spectronaut {{ SN_VERSION }} (command-line mode).

    Usage:
        apptainer run --bind $HOME:$HOME spectronaut.sif <SpectronautCMD args>
        apptainer exec --bind $HOME:$HOME spectronaut.sif spectronaut <SpectronautCMD args>

    Requires a valid Biognosys Spectronaut license to activate/run.
